# Constantes del sistema
# Constantes de la base de datos
# url (host:puerto/nombre_bd, sin prefijo jdbc):
export DB_URL="ruta"
# Usuario:
export DB_USERNAME="nombre"
# Clave:
export DB_PASSWORD="clave"

# Constantes para el token JWT
export JWT_INTERNAL_SECRET="secreto"
export JWT_ALGORITHM=HS512

# Gemini (Google AI Studio)
export GEMINI_API_KEY="llave_de_api"
export GEMINI_MODEL=gemini-3.5-flash-lite

# Google_books_api
export GOOGLE_BOOKS_API_KEY="llave_de_segunda_api"